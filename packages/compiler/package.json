{
  "name": "@qstyle/compiler",
  "version": "1.0.0-alpha.0",
  "description": "Build-time AST compiler for Qstyle native styles.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@qstyle/core": "github:gw31415/qstyle#path:packages/core&git-consumer",
    "magic-string": "^1.2.3",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "^0.3.24",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
