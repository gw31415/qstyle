{
  "name": "@qstyle/inspector",
  "version": "0.1.1",
  "description": "Inspection and reporting utilities for qstyle output.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gw31415/qstyle.git",
    "directory": "packages/inspector"
  },
  "homepage": "https://github.com/gw31415/qstyle#readme",
  "bugs": {
    "url": "https://github.com/gw31415/qstyle/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "qstyle",
    "css",
    "inspector"
  ],
  "dependencies": {
    "@qstyle/core": "github:gw31415/qstyle#path:packages/core&git-consumer"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "publint": "^0.3.24",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
