{
  "name": "@qstyle/vite",
  "version": "0.2.0",
  "description": "Vite plugin that compiles Qwik styles into optimized CSS assets.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gw31415/qstyle.git",
    "directory": "packages/vite"
  },
  "homepage": "https://github.com/gw31415/qstyle#readme",
  "bugs": {
    "url": "https://github.com/gw31415/qstyle/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@qstyle/core": "workspace:^",
    "@qstyle/inspector": "workspace:^",
    "@qstyle/qwik": "workspace:^"
  },
  "peerDependencies": {
    "@qwik.dev/core": "^2.0.0-beta.43",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "publint": "^0.3.24",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "qstyle",
    "qwik",
    "css",
    "vite-plugin",
    "rolldown-plugin"
  ]
}
