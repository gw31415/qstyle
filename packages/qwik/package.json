{
  "name": "@qstyle/qwik",
  "version": "0.1.0",
  "description": "Qwik authoring APIs for css props, tagged templates, and style handles.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gw31415/qstyle.git",
    "directory": "packages/qwik"
  },
  "homepage": "https://github.com/gw31415/qstyle#readme",
  "bugs": {
    "url": "https://github.com/gw31415/qstyle/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@qwik.dev/core": "^2.0.0-beta.43"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "qstyle",
    "qwik",
    "css",
    "styling"
  ],
  "dependencies": {
    "@qstyle/core": "workspace:^",
    "csstype": "^3.2.3"
  },
  "devDependencies": {
    "@qwik.dev/core": "^2.0.0-beta.43",
    "@qwik.dev/router": "^2.0.0-beta.43",
    "@types/node": "^26.4.1",
    "fast-check": "^4.9.0",
    "publint": "^0.3.24",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
