{
  "name": "@qstyle/qwik",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs"
    },
    "./links": {
      "import": "./dist/links.mjs",
      "require": "./dist/links.cjs"
    },
    "./prefetch": {
      "import": "./dist/prefetch.mjs",
      "require": "./dist/prefetch.cjs"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@qwik.dev/core": "^2.0.0-beta.43",
    "@qwik.dev/router": "^2.0.0-beta.43"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@qstyle/core": "workspace:^"
  },
  "devDependencies": {
    "@qwik.dev/core": "^2.0.0-beta.43",
    "@qwik.dev/router": "^2.0.0-beta.43",
    "@types/node": "^26.4.1",
    "publint": "^0.3.24",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
