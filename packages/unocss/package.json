{
  "name": "@qstyle/unocss",
  "version": "0.1.1",
  "description": "UnoCSS integration that compiles utility classes through qstyle.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gw31415/qstyle.git",
    "directory": "packages/unocss"
  },
  "homepage": "https://github.com/gw31415/qstyle#readme",
  "bugs": {
    "url": "https://github.com/gw31415/qstyle/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "qstyle",
    "qwik",
    "unocss",
    "css"
  ],
  "dependencies": {
    "@qstyle/core": "^0.1.1",
    "@unocss/config": "^66.10.0",
    "@unocss/vite": "^66.10.0",
    "unocss": "^66.10.0",
    "@qstyle/compiler": "^1.0.0-alpha.0",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@unocss/preset-wind4": "^66.10.0",
    "fast-check": "^4.9.0",
    "publint": "^0.3.24",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
